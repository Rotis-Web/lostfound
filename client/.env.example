# Lost & Found — web application configuration
#
# Copy to client/.env.local and fill in.
#
# One variable, and it is NEXT_PUBLIC_, so it is inlined into the browser bundle
# at build time. Nothing secret belongs in this file: the API is the only thing
# the client talks to, and it holds every credential.

# required. The API origin INCLUDING its base path — every fetch in the app
# appends a route to this string, so http://localhost:8000 without /api/v1 turns
# the whole application into 404s.
#
# Must match the API's own BASE_PATH (default /api/v1), and the API's
# FRONTEND_URL must in turn name this application's origin, or CORS rejects
# every request.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
