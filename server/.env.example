# Lost & Found — API configuration
#
# Copy to server/.env and fill in. Every value below is a placeholder; none of
# them work as written.
#
# Configuration is read through getEnv() in src/utils/get-env.ts, which throws at
# startup for any variable that has neither a value here nor a default in
# src/config/app.config.ts. A missing secret therefore fails the process rather
# than the first request that needs it. The variables marked "optional" are the
# ones carrying a default.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# optional — default "development".
# "production" is what adds Secure to the refresh cookie, so it must be set on
# any deployment served over HTTPS.
NODE_ENV=development

# optional — default "8000"
PORT=8000

# optional — default "/api/v1". Prefixed to every route. The client's
# NEXT_PUBLIC_API_URL has to include whatever this is set to.
BASE_PATH=/api/v1

# optional — default "http://localhost:3000".
# The single origin CORS accepts, and the base for the links in verification and
# password-reset mail. Scheme and port must match the web application exactly.
FRONTEND_URL=http://localhost:3000

# optional — default "localhost"
APP_ORIGIN=http://localhost:8000

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------

# required. Mongoose creates the indexes on first connection; there is no
# migration step.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/lostfound

# required. Backs the rate-limit counters and the geocoding cache.
#
# The client in src/config/redis.ts is constructed with tls: {} unconditionally,
# so this has to be a TLS endpoint — a managed instance (Upstash, Redis Cloud)
# rather than a plain local container. To develop against a local Redis, drop
# that option first.
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------

# required, both of them. Generate with: openssl rand -base64 48
#
# They must differ. Reusing one secret for both makes a refresh token acceptable
# wherever an access token is — including as a Bearer credential on every
# authenticated route.
#
# Access tokens last 1 hour, refresh tokens 7 days; both lifetimes are set in
# src/utils/generateToken.ts rather than read from here.
JWT_SECRET=replace-me-with-48-random-bytes-base64
JWT_REFRESH_SECRET=replace-me-with-different-48-random-bytes

# ---------------------------------------------------------------------------
# Images — Cloudinary
# ---------------------------------------------------------------------------

# required. Uploads land in the "lost-found-posts" folder, bounded to 1200x1200
# with automatic format and quality.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# Mail — SMTP
# ---------------------------------------------------------------------------

# required. Carries the address-verification and password-reset messages, sent
# over Nodemailer. A send failure during registration is logged and swallowed, so
# a misconfigured mailbox shows up as an account that can never sign in rather
# than as an error at the point of registering.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# required. The From identity on both messages.
FROM_EMAIL=noreply@example.com
FROM_NAME=Lost & Found

# required, and unused.
#
# app.config.ts reads it, so the process will not start without it, but every
# message goes out over SMTP above — nothing in the codebase constructs a Resend
# client. Any non-empty placeholder satisfies it. Remove the variable and the
# dependency together, or wire Resend up; leaving it as it stands makes a
# deployment fail for a credential it never uses.
RESEND_API_KEY=unused-placeholder
